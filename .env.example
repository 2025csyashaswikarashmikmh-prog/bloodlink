# Copy to .env and adjust. Never commit the real .env.
POSTGRES_PASSWORD=raktasetu
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
DEMO_MODE=true              # returns OTP on screen; set false when an SMS gateway is wired up
RESPONSE_WINDOW_SEC=120     # how long a donor has to respond before the alert expires
COMMITMENT_WINDOW_MIN=90    # how long an accepted donor has to check in
TELEGRAM_BOT_TOKEN=         # optional: real phone push notifications via a Telegram bot
FRONTEND_PORT=8080
REGISTRY=yourdockerhubusername
TAG=latest
